# Match Report uses your local Claude Code CLI (which uses your Pro subscription).
# No API key required — just make sure `claude --version` works in a terminal.

# Spond login (used to pull match RSVPs into the Team Builder)
# Optional — only needed for the "Import Spond availability" button
SPOND_EMAIL=your-spond-email@example.com
SPOND_PASSWORD=your-spond-password

PORT=3001
