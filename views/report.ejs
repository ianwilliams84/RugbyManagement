<%- include('partials/head', { title: 'Match Report' }) %>
<%- include('partials/nav', { active: 'report' }) %>
<main class="container">
  <div class="page-head">
    <h1>Match Report</h1>
    <p class="muted">Generate a Sky Sports–style match report from a recorded result, written by Claude.</p>
  </div>

  <% if (!engine.ready) { %>
    <div class="panel warn">
      <strong><%= engine.problem %></strong>
      <% if (engine.mode === 'cli') { %>
        Install Claude Code from <a href="https://docs.claude.com/claude-code" target="_blank" rel="noopener">docs.claude.com/claude-code</a>, or
      <% } %>
      <a href="/setup">open Setup</a> to choose how match reports are written on this PC.
    </div>
  <% } %>

  <!-- Step 1: pick a match -->
  <section class="panel" id="match-picker">
    <h2>1. Select match</h2>
    <% if (!matches.length) { %>
      <p class="muted">No matches recorded yet. Record one on the <a href="/results">Results</a> page first — the score, scorers and your notes are what the report is written from.</p>
    <% } else { %>
      <div id="match-rows">
        <% matches.forEach(m => { %>
          <div class="match-list-row<%= m.id === openId ? ' active' : '' %>" data-id="<%= m.id %>">
            <span class="match-list-label">
              <%= new Date(m.date + 'T00:00:00').toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %> ·
              <strong><%= m.teamName %></strong> <%= m.homeAway === 'away' ? '@' : 'vs' %> <%= m.opposition %> ·
              <%= m.scoreFor !== '' ? m.scoreFor : '?' %>–<%= m.scoreAgainst !== '' ? m.scoreAgainst : '?' %>
              <% if (m.letter) { %><span class="result-pill r-<%= m.letter %>"><%= m.letter %></span><% } %>
            </span>
            <button class="btn small load-match-btn" data-id="<%= m.id %>">Load</button>
          </div>
        <% }) %>
      </div>
    <% } %>
  </section>

  <!-- Step 2: match data preview -->
  <section class="panel" id="scorecard-section" hidden>
    <h2>2. Match data</h2>
    <p id="scorecard-title" class="muted small"></p>
    <div id="scorecard-body"></div>
    <div class="actions" style="margin-top:1rem">
      <button type="button" id="generate-btn" class="btn primary" <%= cliReady ? '' : 'disabled' %>>Generate report</button>
      <a id="edit-match-link" class="btn">Edit match</a>
      <span id="gen-status" class="muted small"></span>
    </div>
    <p class="muted small">Generation takes 20–60 s<%= engine.mode === 'api' ? ' and is billed to the Anthropic API key saved in Setup' : ' and uses this PC\'s Claude Code subscription' %>. Add key moments in the match's coach notes for a richer report.</p>
  </section>

  <!-- Step 3: report output -->
  <section id="report-output" class="panel report" hidden>
    <h2>3. Report</h2>
    <div class="report-toolbar">
      <button id="download-html" class="btn primary">⬇ Download HTML</button>
      <button id="copy-html" class="btn">Copy HTML</button>
      <button id="copy-text" class="btn">Copy plain text</button>
    </div>
    <article id="report-body"></article>
    <p id="usage" class="muted small"></p>
  </section>
</main>
<script id="initial-data" type="application/json"><%- JSON.stringify({ openId, primary: settings.club.primaryColor, dark: settings.club.primaryDark }) %></script>
<script src="/js/report.js"></script>
<%- include('partials/foot') %>
