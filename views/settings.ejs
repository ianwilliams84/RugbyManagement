<%- include('partials/head', { title: 'Settings' }) %>
<%- include('partials/nav', { active: 'settings' }) %>
<main class="container settings-page">
  <div class="page-head">
    <h1>Settings</h1>
    <p class="muted">Tool-wide configuration. Secrets like the Spond password live in <code>pw.env</code>.</p>
  </div>

  <section class="panel">
    <h2>Credential status</h2>
    <ul class="status-list">
      <li><span class="dot <%= env.claudeCli ? 'on' : 'off' %>"></span> Claude Code CLI <span class="muted">— used by Match Report (uses your Pro subscription, no API key needed)</span></li>
      <li><span class="dot <%= env.spond ? 'on' : 'off' %>"></span> Spond login <span class="muted">— used to import per-match RSVPs (button on Team Builder)</span></li>
    </ul>
  </section>

  <form id="settings-form" class="panel">
    <h2>Club</h2>
    <div class="match-fields">
      <label>Club name <input name="clubName" value="<%= settings.club.name %>"></label>
      <label>Short name <input name="clubShortName" value="<%= settings.club.shortName %>"></label>
      <label>Founded <input name="clubFounded" value="<%= settings.club.founded || '' %>"></label>
      <label>Primary colour <input name="primaryColor" type="color" value="<%= settings.club.primaryColor %>"></label>
      <label>Primary colour (dark) <input name="primaryDark" type="color" value="<%= settings.club.primaryDark %>"></label>
    </div>

    <h2>Teams &amp; season</h2>
    <div class="match-fields">
      <label>Team 1 name <input name="team1Name" value="<%= settings.teams.names[0] %>" placeholder="e.g. 1st XV"></label>
      <label>Team 2 name <input name="team2Name" value="<%= settings.teams.names[1] %>" placeholder="e.g. 2nd XV (blank if none)"></label>
      <label>Team 3 name <input name="team3Name" value="<%= settings.teams.names[2] %>" placeholder="e.g. Vets (blank if none)"></label>
      <label>Current season <input name="currentSeason" value="<%= settings.season.current %>" placeholder="2025/26" pattern="\d{4}/\d{2}"></label>
      <label>Home postcode <input name="homePostcode" value="<%= settings.homePostcode || '' %>" placeholder="e.g. B23 5AB" maxlength="12"></label>
    </div>
    <p class="muted small" style="margin:.25rem 0 0">Squad numbers 1/2/3 on the player cards refer to these teams. Home postcode is the origin for the driving-distance column on the Fixtures page.</p>

    <h2>Spond</h2>
    <div class="match-fields">
      <label>Spond email <input id="spond-email-input" type="email" value="<%= env.spondEmail || '' %>" placeholder="your@spond-account.com" autocomplete="username"></label>
      <label>Spond password <input id="spond-password-input" type="password" value="" placeholder="(leave blank to keep current)" autocomplete="current-password"></label>
      <label class="full">Current event id <input id="spond-event-input" name="spondEventId" value="<%= settings.spond.currentEventId %>" placeholder="paste from Spond URL or use Fetch upcoming events below"></label>
    </div>
    <div class="actions">
      <button type="button" id="spond-relogin-btn" class="btn primary">Save &amp; sign in</button>
      <button type="button" id="spond-test-btn" class="btn">Test Spond login</button>
      <button type="button" id="spond-events-btn" class="btn">Fetch upcoming events</button>
      <span id="spond-status" class="muted small"></span>
    </div>
    <p class="muted small" style="margin:.25rem 0 0">Use "Save &amp; sign in" to update the email/password and force a fresh login (credentials are saved to <code>pw.env</code> so they persist across restarts). "Test" just re-uses the currently-cached token.</p>
    <div id="spond-events-list" class="spond-events" hidden></div>

    <h2>Match Report (AI)</h2>
    <div class="match-fields">
      <label class="full">Tone notes for Claude <textarea name="matchReportTone" rows="3"><%= settings.matchReport.tone %></textarea></label>
      <label>Target length (words) <input name="matchReportLength" type="number" value="<%= settings.matchReport.lengthWords %>"></label>
    </div>

    <div class="actions">
      <button type="submit" class="btn primary">Save Settings</button>
      <span id="save-status" class="muted"></span>
    </div>
  </form>

  <section class="panel" id="players-panel">
    <h2>Players</h2>
    <p class="muted small">Your squad roster. Tag each player's positions so the Team Builder can flag anyone picked out of position, and tick which teams they usually play for.</p>

    <div class="add-players">
      <label class="full">Add players — one name per line
        <textarea id="add-names" rows="4" placeholder="Tom Smith&#10;Jack Jones&#10;…"></textarea>
      </label>
      <div class="add-players-opts">
        <div class="muted small">Positions (optional, applied to all)</div>
        <div class="tag-picker" id="add-positions">
          <% positionTags.forEach(t => { %><label class="tag-tick"><input type="checkbox" value="<%= t %>"> <%= t %></label><% }) %>
        </div>
        <div class="muted small" style="margin-top:.4rem">Teams</div>
        <div class="tag-picker" id="add-teams">
          <% [1,2,3].forEach(n => { %><label class="tag-tick"><input type="checkbox" value="<%= n %>"> <%= settings.teams.names[n - 1] || `Team ${n}` %></label><% }) %>
        </div>
        <div class="actions" style="margin-top:.5rem">
          <button type="button" id="add-btn" class="btn primary">Add players</button>
          <span id="add-status" class="muted small"></span>
        </div>
      </div>
    </div>

    <div class="table-scroll">
      <table id="players-table" class="players-table">
        <thead><tr><th>Name</th><th>Positions</th><th>Team(s)</th><th>Notes</th><th>Photo id</th><th></th></tr></thead>
        <tbody id="players-tbody"><tr><td colspan="6" class="muted">Loading…</td></tr></tbody>
      </table>
    </div>

    <div class="actions" style="margin-top:1rem">
      <button type="button" id="delete-all-btn" class="btn danger">Delete all players</button>
    </div>
  </section>
</main>
<script id="settings-data" type="application/json"><%- JSON.stringify({ positionTags, teamNames: settings.teams.names }) %></script>
<script>
  document.getElementById('settings-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(e.target);
    const body = {};
    for (const [k, v] of fd.entries()) body[k] = v;
    const status = document.getElementById('save-status');
    status.textContent = 'Saving…';
    const res = await fetch('/settings/save', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    });
    status.textContent = res.ok ? 'Saved. Reloading…' : 'Save failed.';
    if (res.ok) setTimeout(() => location.reload(), 600);
  });

  function esc(s) {
    return String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  }

  document.getElementById('spond-test-btn').addEventListener('click', async () => {
    const s = document.getElementById('spond-status');
    s.textContent = 'Connecting…';
    try {
      const res = await fetch('/spond-availability/test', { method: 'POST' });
      const json = await res.json();
      s.textContent = json.ok
        ? `Connected — user ${json.userId || '(unknown)'}`
        : 'Failed: ' + (json.error || res.statusText);
    } catch (e) { s.textContent = 'Failed: ' + e.message; }
  });

  // Save new email/password and force a fresh login.
  document.getElementById('spond-relogin-btn').addEventListener('click', async () => {
    const s = document.getElementById('spond-status');
    const emailEl = document.getElementById('spond-email-input');
    const passEl  = document.getElementById('spond-password-input');
    const email = (emailEl.value || '').trim();
    const password = passEl.value || '';
    if (!email) { s.textContent = 'Enter the Spond email address.'; return; }
    if (!password) { s.textContent = 'Enter the password (it is not stored in the browser; the server saves it to pw.env).'; return; }
    s.textContent = 'Signing in…';
    try {
      const res = await fetch('/spond-availability/relogin', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, password }),
      });
      const json = await res.json();
      if (json.ok) {
        s.textContent = `Signed in — saved to pw.env (${json.email || email}).`;
        passEl.value = '';
      } else {
        s.textContent = 'Failed: ' + (json.error || res.statusText);
      }
    } catch (e) { s.textContent = 'Failed: ' + e.message; }
  });

  document.getElementById('spond-events-btn').addEventListener('click', async () => {
    const wrap = document.getElementById('spond-events-list');
    const s = document.getElementById('spond-status');
    wrap.hidden = false;
    wrap.textContent = 'Fetching…';
    s.textContent = '';
    try {
      const res = await fetch('/spond-availability/events', { method: 'POST' });
      const json = await res.json();
      if (!json.ok) { wrap.textContent = 'Error: ' + json.error; return; }
      if (!json.events.length) { wrap.textContent = 'No events found.'; return; }
      const rows = json.events.map(ev => `
        <tr>
          <td><button type="button" class="btn small" data-eid="${esc(ev.id)}">Use</button></td>
          <td>${esc(ev.name)}</td>
          <td>${esc(ev.startTimestamp || '')}</td>
          <td>${ev.memberCount}</td>
        </tr>`).join('');
      wrap.innerHTML = `<table><thead><tr><th></th><th>Event</th><th>Date (UTC)</th><th>Members</th></tr></thead><tbody>${rows}</tbody></table>`;
      wrap.querySelectorAll('button[data-eid]').forEach(b => {
        b.addEventListener('click', () => {
          document.getElementById('spond-event-input').value = b.dataset.eid;
          s.textContent = 'Event id pasted — click Save Settings to persist.';
        });
      });
    } catch (e) { wrap.textContent = 'Error: ' + e.message; }
  });
</script>
<script src="/js/settings-players.js"></script>
<%- include('partials/foot') %>
